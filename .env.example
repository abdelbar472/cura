# Cura settings (all optional). Prefix: CURA_
CURA_ENVIRONMENT=dev
CURA_LOG_LEVEL=INFO

# Case store: memory | postgres
# Postgres falls back to memory (and reports degraded) if it is unreachable.
CURA_STORE_BACKEND=postgres
CURA_STORE_MAX_CASES=1000
CURA_DATABASE_URL=postgresql+psycopg://cura:cura@localhost:5433/cura
CURA_DATABASE_ECHO=false

# ML layer. Models load lazily on first use; rules always remain authoritative.
CURA_ML_ENABLED=true
CURA_ML_DEVICE=cpu
CURA_ML_ARTIFACT_DIR=artifacts
CURA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CURA_SYMPTOM_ML_THRESHOLD=0.55
CURA_SYMPTOM_ML_MARGIN=0.05
CURA_LAB_ANOMALY_CONTAMINATION=0.10
CURA_DIFFERENTIAL_ML_WEIGHT=0.35
CURA_DRUG_FUZZY_THRESHOLD=0.84
CURA_DRUG_EMBEDDING_THRESHOLD=0.72

# Symptom agent: auto | lexicon | scispacy
CURA_SYMPTOM_BACKEND=auto
CURA_SYMPTOM_MODEL=en_core_sci_sm

# Differential diagnosis
CURA_DIFFERENTIAL_TOP_K=5
CURA_DIFFERENTIAL_MIN_SCORE=0.05

# Imaging: auto | null | hf. auto uses the chest X-ray model only when
# image_base64 is supplied; other modalities stay on the null backend.
CURA_IMAGING_BACKEND=auto
CURA_IMAGING_MODEL_ID=nickmuchi/vit-finetuned-chest-xray-pneumonia
CURA_IMAGING_CONFIDENCE_THRESHOLD=0.55

# Event bus: leave Kafka disabled to use the in-process bus
CURA_KAFKA_ENABLED=false
CURA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CURA_KAFKA_TOPIC_PREFIX=cura
CURA_KAFKA_CLIENT_ID=cura-api
CURA_KAFKA_MAX_BLOCK_MS=3000
