# Cura settings (all optional). Prefix: CURA_
CURA_ENVIRONMENT=dev
CURA_LOG_LEVEL=INFO

# In-memory case store capacity
CURA_STORE_MAX_CASES=1000

# Symptom agent: auto | lexicon | scispacy
CURA_SYMPTOM_BACKEND=auto
CURA_SYMPTOM_MODEL=en_core_sci_sm

# Differential diagnosis
CURA_DIFFERENTIAL_TOP_K=5
CURA_DIFFERENTIAL_MIN_SCORE=0.05

# Event bus: leave Kafka disabled to use the in-process bus
CURA_KAFKA_ENABLED=false
CURA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CURA_KAFKA_TOPIC_PREFIX=cura
CURA_KAFKA_CLIENT_ID=cura-api
CURA_KAFKA_MAX_BLOCK_MS=3000
